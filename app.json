{
  "expo": {
    "name": "Panela",
    "slug": "sport-app-mobile",
    "scheme": "panela",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.panela.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O Panela usa sua localização para mostrar os jogos acontecendo perto de você."
      }
    },
    "android": {
      "package": "com.panela.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFEFB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C1614"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Panela usa sua localização para mostrar os jogos acontecendo perto de você."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-font"
    ]
  }
}
